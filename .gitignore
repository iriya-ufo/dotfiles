# Ignore files

# Mac Emacs
Mac/.emacs.d/history
Mac/.emacs.d/request
Mac/.emacs.d/.lsp-session-v1
Mac/.emacs.d/cache/*
Mac/.emacs.d/.cache/*
Mac/.emacs.d/transient
Mac/.emacs.d/straight/*
!Mac/.emacs.d/straight/versions/
Mac/.emacs.d/straight/versions/*
!Mac/.emacs.d/straight/versions/default.el

# M2 Mac Emacs
M2-Mac/.emacs.d/history
M2-Mac/.emacs.d/request
M2-Mac/.emacs.d/.lsp-session-v1
M2-Mac/.emacs.d/cache/*
M2-Mac/.emacs.d/.cache/*
M2-Mac/.emacs.d/transient
M2-Mac/.emacs.d/straight/*
!M2-Mac/.emacs.d/straight/versions/
M2-Mac/.emacs.d/straight/versions/*
!M2-Mac/.emacs.d/straight/versions/default.el

# Arch Emacs
Arch/.emacs.d/history
Arch/.emacs.d/request
Arch/.emacs.d/.lsp-session-v1
Arch/.emacs.d/cache/*
Arch/.emacs.d/.cache/*
Arch/.emacs.d/transient
Arch/.emacs.d/straight/*
!Arch/.emacs.d/straight/versions/
Arch/.emacs.d/straight/versions/*
!Arch/.emacs.d/straight/versions/default.el

# Clojure
Mac/.lein/repl-history

# jj: リポジトリごとの自動生成キャッシュ(絶対パス依存のため環境間で共有しない)
*/jj/repos/

# herdr-app: Herdr が起動ごとに書き換える同梱物と実行時の状態（自分で編集する設定だけを追跡する）
# 同梱物（起動のたびに丸ごと置き換えられる。カスタマイズは clone して別名で行う）
